<h1>Create New Post</h1>
<form action="/posts" method="POST">
    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" class="form-control" id="title" name="title" required placeholder="Post title">
    </div>
    <div class="mb-3">
        <label for="content" class="form-label">Content</label>
        <textarea class="form-control" id="content" name="content" rows="5" required
            placeholder="What's on your mind?"></textarea>
    </div>
    <div class="mb-3">
        <label for="authorId" class="form-label">Author ID</label>
        <input type="number" class="form-control" id="authorId" name="authorId" min="1" step="1" required
            placeholder="ID of an existing user">
        <div class="form-text">The user must already exist (create one via <code>POST /users</code>).</div>
    </div>
    <div class="mb-3 form-check">
        <input type="hidden" name="published" value="false">
        <input type="checkbox" class="form-check-input" id="published" name="published" value="true">
        <label for="published" class="form-check-label">Published</label>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Create Post</button>
        <a href="/posts" class="btn btn-secondary">Cancel</a>
    </div>
</form>
