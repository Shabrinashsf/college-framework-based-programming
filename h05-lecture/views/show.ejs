<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Post Details</h1>
    <div>
        <a href="/posts/<%= post.id %>/edit" class="btn btn-warning">Edit</a>
        <a href="/posts" class="btn btn-secondary">Back to Posts</a>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <h4 class="card-title">
            <%= post.title %>
            <% if (post.published) { %>
                <span class="badge bg-success">Published</span>
            <% } else { %>
                <span class="badge bg-secondary">Draft</span>
            <% } %>
        </h4>
        <p class="card-text">
            <%= post.content %>
        </p>
        <div class="mt-3">
            <small class="text-muted">
                <strong>ID:</strong>
                <%= post.id %><br>
                <strong>Author:</strong>
                <%= post.author.name %> (<%= post.author.email %>)<br>
                <strong>Created:</strong>
                <%= post.createdAt.toLocaleString() %><br>
                <strong>Updated:</strong>
                <%= post.updatedAt.toLocaleString() %>
            </small>
        </div>
    </div>
</div>
<div class="mt-3">
    <form action="/posts/<%= post.id %>/delete" method="POST" style="display: inline;">
        <button type="submit" class="btn btn-danger"
            onclick="return confirm('Are you sure you want to delete this post?')">Delete Post</button>
    </form>
</div>
